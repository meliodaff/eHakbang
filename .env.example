# ─────────────────────────────────────────────────────────────────────────────
# eHakbang environment template
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored — never commit real secrets. Keys marked (secret) must come from
# the corresponding provider/partner dashboard.
#
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# ── eGov SSO ("Continue with eGov") ─────────────────────────────────────────
# Custom exchange-code flow. exchangeEgovCode() -> POST {BASE_URL}/api/token
# authenticates the partner with PARTNER_CODE + PARTNER_SECRET, then
# fetchEgovProfile() -> POST {BASE_URL}/api/partner/sso_authentication.
# Used by: lib/server/egov-sso.ts, scripts/egov-sso-smoke.mjs
EGOV_SSO_BASE_URL=https://platforms-api.e.gov.ph/egov-sso
EGOV_SSO_PARTNER_CODE=TEST_AGENCY
EGOV_SSO_PARTNER_SECRET=          # (secret) from the eGov partner dashboard — REQUIRED to mint the token
# Real eGov login redirect target (stand-in dev page used when unset).
# Used by: app/auth/egov/start/route.ts
EGOV_SSO_AUTHORIZE_URL=

# ── Supabase (auth + profiles) ──────────────────────────────────────────────
# Used by: lib/supabase/*
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # (secret) server-only, bypasses RLS — never expose client-side

# ── OpenAI (journey classification / ask-step) ──────────────────────────────
# Used by: lib/server/ask-step.ts, classify-life-event.ts, openai-journey.ts
OPENAI_API_KEY=                   # (secret)
OPENAI_ASK_STEP_MODEL=gpt-4.1-mini
OPENAI_CLASSIFY_MODEL=gpt-4.1-mini
OPENAI_JOURNEY_MODEL=gpt-4.1

# ── eGovPay (payment gateway) ───────────────────────────────────────────────
# Used by: lib/server/egovpay.ts
EGOVPAY_BASE_URL=
EGOVPAY_API_TOKEN=                # (secret) test_-prefixed token runs in test mode
EGOVPAY_SETTLEMENT_TEMPLATE_UUID=

# ── eGov Liveness (face/liveness check) ─────────────────────────────────────
# Used by: lib/server/liveness.ts, app/api/liveness/session/route.ts
EGOV_LIVENESS_BASE_URL=
EGOV_LIVENESS_API_KEY=            # (secret)
LIVENESS_MOCK=true                # dev-only: force-mock liveness when true

# ── eMessage (notifications) ────────────────────────────────────────────────
# Used by: lib/server/emessage.ts
EMESSAGE_BASE_URL=
EMESSAGE_API_TOKEN=               # (secret)

# ── Cloudflare Turnstile (bot protection) ───────────────────────────────────
# Used by: components/auth/TurnstileWidget.tsx
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
